{
  "expo": {
    "name": "Pandara Samaja",
    "slug": "pandara-samaja",
    "scheme": "pandarasamaja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0f172a",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "in.nikhilaodishapandarasamaja.app",
      "supportsTablet": false,
      "splash": {
        "backgroundColor": "#0f172a",
        "image": "./assets/splash.png"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Pandara Samaja to access your camera to add filtered photos to your story."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": ["CAMERA"],
      "package": "in.nikhilaodishapandarasamaja.app",
      "googleServicesFile": "./google-services.json",
      "splash": {
        "backgroundColor": "#0f172a",
        "image": "./assets/splash.png",
        "mdpi": "./assets/splash.png",
        "hdpi": "./assets/splash.png",
        "xhdpi": "./assets/splash.png",
        "xxhdpi": "./assets/splash.png",
        "xxxhdpi": "./assets/splash.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to update your profile picture and share posts.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take a profile picture or share a photo."
        }
      ],
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to go live.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to go live."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "react-native-compressor"
    ],
    "extra": {
      "eas": {
        "projectId": "3d3326a8-a582-496b-98e9-9f94e9b4e4ef"
      }
    },
    "owner": "ranjit0034",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3d3326a8-a582-496b-98e9-9f94e9b4e4ef"
    }
  }
}
